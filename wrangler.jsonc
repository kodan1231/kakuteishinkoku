{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kakuteishinkoku",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kakuteishinkoku",
      "database_id": "3c5208f4-f598-49bf-af85-be36af08dc85",
      "migrations_dir": "migrations"
    }
  ],
  // GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / ADMIN_EMAIL / OCR_LAB_KEY はダッシュボードで設定する。
  // 自動デプロイで消えないように、ダッシュボード側の変数を保持する。
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
